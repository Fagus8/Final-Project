generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  accountType   String

  sessions Session[]
  accounts Account[]

  patient Patient?

  clinic Clinic?

  // ექიმის ანგარიში — ექიმს ანგარიშთან userId აკავშირებს და არა ელფოსტა
  doctor Doctor?

  appointments Appointment[]
}

model Session {
  id             String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// პაციენტის დამატებითი მონაცემები (სახელი და ელფოსტა User-შია)
model Patient {
  id        String  @id @db.Uuid
  phone     String?
  // მაგ: "A(II)+"; null — პაციენტმა ჯერ არ იცის
  bloodType String?

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
}

model Doctor {
  id              String  @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  name            String
  specialty       String
  experienceYears Int     @default(0)
  avatarUrl       String?
  isApproved      Boolean @default(false)

  // ექიმის ანგარიში. ექიმი თვითონ რეგისტრირდება და კლინიკას ირჩევს,
  // ამიტომ ყველა ექიმს ანგარიში აქვს (ელფოსტაც User-შია)
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // კაბინეტის ნომერი
  room      String?
  // სამუშაო საათები, მაგ: "10:00" - "18:00"
  workStart String  @default("10:00")
  workEnd   String  @default("18:00")

  // პროფილის ინფორმაცია
  bio             String?
  education       String?
  // საუბრობს ენებზე, მაგ: ["ქართული", "ინგლისური"]
  languages       String[] @default([])
  // სერვისები / პროცედურები
  services        String[] @default([])
  // კონსულტაციის ფასი ლარში
  consultationFee Int?

  clinicId String @db.Uuid
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  appointments Appointment[]
}

model Appointment {
  id           String   @id @default(dbgenerated("pg_catalog.gen_random_uuid()")) @db.Uuid
  startsAt     DateTime
  // BOOKED, COMPLETED, CANCELLED
  status       String   @default("BOOKED")
  diagnosis    String?
  prescription String?
  createdAt    DateTime @default(now())

  doctorId  String @db.Uuid
  doctor    Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patientId String @db.Uuid
  patient   User   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
  @@index([patientId])
}

model Clinic {
  id         String   @id @db.Uuid
  name       String
  city       String
  address    String
  phone      String
  specialty  String
  imageUrl   String?
  isApproved Boolean  @default(false)
  doctors    Doctor[]

  user User @relation(fields: [id], references: [id], onDelete: Cascade)
}
